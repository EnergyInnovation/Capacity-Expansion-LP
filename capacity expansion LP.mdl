Net Revenue per MW[Region,electricity source]=
	Energy Market Revenue per MW[Region,electricity source]
	+Capacity Revenue per MW[Region,electricity source]
	-Annual FOM Costs for Existing Capacity[Region,electricity source]
	-Variable Costs per MW[Region,electricity source]
	~	$/MW
	~		|

MPPC Minimum Power Plant Capacity[electricity source]=
	GET DIRECT CONSTANTS('/InputData/elec/MPPC/MPPC.csv', 'MPPC' , 'B2*' )
	~	
	~		|

Variable Costs per MW[Region, electricity source]=
	ZIDZ((Fuel Cost per Unit Output[Region,electricity source]+VOM including Subsidies[Region\
		,electricity source])*SUM(Electricty Generation by Plant Type[Region,electricity source\
		,timeslice!,hours of day!]),This Year Installed Capacity[Region,electricity source]\
		)
	~	$/MW
	~		|

This Year CAPEX[Region,electricity source] :EXCEPT:  [Region, onshore wind es],[Region\
		, solar PV es],[Region, offshore wind es]=
	Start Year CAPEX[electricity source] ~~|
This Year CAPEX[Region,onshore wind es]=
	Start Year CAPEX[onshore wind es]*(1-0.02)^(Time-INITIAL TIME) ~~|
This Year CAPEX[Region,solar PV es]=
	Start Year CAPEX[solar PV es]*(1-0.03)^(Time-INITIAL TIME) ~~|
This Year CAPEX[Region,offshore wind es]=
	Start Year CAPEX[offshore wind es]*(1-0.04)^(Time-INITIAL TIME)
	~	
	~		|

CES Qualifying Technologies[electricity source] :EXCEPT: [CES electricity source]=
	0 ~~|
CES Qualifying Technologies[CES electricity source]=
	1
	~	dmnl
	~		|

This Year Installed Capacity[Region, electricity source]=
	New Capacity[Region,electricity source]
	+Last Year Installed Capacity[Region,electricity source]
	-Capacity Retired Economically[Region,electricity source]
	~	
	~		|

Energy Market Revenue per MW[Region, electricity source]=
	LP REV EN PERMW INSTALLED(Region Numbers[Region] ,Electricity source number[electricity source\
		],2)+ObjVal*0
	~	$
	~		|

Capacity Revenue per MW[Region,electricity source]=
	LP REV CAP PERMW INSTALLED(Region Numbers[Region] ,Electricity source number[electricity source\
		],2)+ObjVal*0
	~	$/MW
	~		|

Annual FOM Costs for Existing Capacity[Region,electricity source]=
	Ongoing CAPEX[electricity source]
	~	$/MW
	~		|

Last Year Revenue per MW[Region, electricity source]=
	DELAY FIXED(Net Revenue per MW[Region,electricity source], 1, 0 )
	~	
	~		|

