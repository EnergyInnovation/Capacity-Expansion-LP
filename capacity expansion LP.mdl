	~	$/MMbtu
	~		|

Three Years Prior Revenue per MW[Region, electricity source]=
	DELAY FIXED(Two Years Prior Revenue per MW[Region,electricity source], 1, 0 )
	~	
	~		|

Two Years Prior Revenue per MW[Region, electricity source]=
	DELAY FIXED( Last Year Revenue per MW[Region,electricity source],1,0)
	~	
	~		|

Power Plant Economic Retirement Eligibility[Region, electricity source]=
	IF THEN ELSE(Last Year Revenue per MW[Region,electricity source]<0 :AND:Two Years Prior Revenue per MW\
		[Region,electricity source]<0 :AND:Three Years Prior Revenue per MW[Region,electricity source\
		]<0,1,0)
	~	dmnl
	~		|

Last Year Installed Capacity[Region, electricity source]= INTEG (
	New Capacity[Region,electricity source]-Capacity Retired Economically[Region,electricity source\
		],
		Start Year Capacity by Region[Region,electricity source])
	~	
	~		|

Capacity Retired per Unit Net Loss[Region, electricity source]=
	0.002
	~	MW/($/MW)
	~		|

Decommisioning Costs per Unit Capacity[Region,electricity source]=
	0
	~	$/MW
	~		|

Annual Capital Recovery[Region,electricity source]=
	(Weighted Average Cost of Capital*(1 + Weighted Average Cost of Capital)^20) / ((1 +\
		 Weighted Average Cost of Capital)^20 - 1)
	*(This Year CAPEX[Region,electricity source]-Subsidy per Unit New Capacity[Region,electricity source\
		])
	~	$/MW
	~		|

