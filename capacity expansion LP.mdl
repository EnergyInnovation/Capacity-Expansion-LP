{UTF-8}
LP Anchor to Mean=
	1
	~	
	~		|

LP Solution=
	LP SOLVE(
	  Demand Across Timeslice[Region1, average winter,Hour0],
	  Capacity Factor[Region1,hard coal es,average winter,Hour0],
	  Hours[average winter, Hour0],
	  Peak Seasons and Hours[average winter,Hour0],
	  Annual Capital Recovery[Region1,hard coal es],
	  FOM by Region[Region1,hard coal es],
	  Fuel Cost per Unit Output[Region1,hard coal es],
	  VOM including Subsidies[Region1,hard coal es],
	  Last Year Installed Capacity[Region1,hard coal es],
	  Max Buildable Capacity This Year[Region1,hard coal es],
	  Max Technical Capacity[Region1,hard coal es],
	  Interregion Transfer Capacity Matrix[Import Region1,Export Region1],
	  CES Qualifying Technologies[hard coal es],
	  RPS Qualifying Technologies[hard coal es],
	  Annual FOM Costs for Existing Capacity[Region1,hard coal es],
	  Decommisioning Costs per Unit Capacity[Region1,hard coal es],
	  Three Average Net Revenue per MW[Region1,hard coal es],
	  Capacity Retired per Unit Net Loss[Region1,hard coal es],
	  Power Plant Economic Retirement Eligibility[Region1,hard coal es],
	  Last Year Grid Battery Storage Capacity[Region1],
	  Grid Battery Capacity Max Annual Build[Region1],
	  Max Total Grid Battery Capacity[Region1],
	  Grid Battery Capacity Costs[Region1],
	  Grid Battery FOM Capacity Costs[Region1],
	  Grid Battery Energy Costs[Region1],
	  Grid Battery FOM Energy Costs[Region1],
	  Grid Battery Charging VOM Costs[Region1],
	  Grid Battery Discharging VOM Costs[Region1],
	  MPPC Minimum Power Plant Capacity[hard coal es],
	  NSDoDC Normalized Standard Deviation of Dispatch Costs[hard coal es],
	  CES RHS,
	  CES ACP,
	  RPS RHS,
	  RPS ACP,
	  Fraction of Forward Costs that Have to be Covered to Avoid Retirement,
	  Reserve Margin,
	  Grid Battery Storage Charging Efficiency,
	  Grid Battery Storage Discharging Efficiency,
	  Grid Battery Initial State of Charge,    {fraction 0..1}
	  Storage Cyclical Switch,                 {0/1}
	  Grid Battery Storage Capacity Credit,    {fraction}
	  Minimum Plant Size Switch,               {0/1; not enforced in core LP}
	  Number of Blocks per Dispatch Curve,
	  LP Anchor to Mean,
	  ELMCOUNT(Region),
	  ELMCOUNT(timeslice),
	  ELMCOUNT(hours of day),
	  ELMCOUNT(electricity source),
	  2 {Scenario: 1 = BAU, 2 = Policy}
	)
	~	
	~		|

Battery Charging[Region,timeslice,hours of day]=
	LP STOR CHARGE(Region Numbers[Region], Timeslice Numbers[timeslice] , Hour Numbers[hours of day\
		] ,2)
	~	
	~		|

Battery Discharging[Region,timeslice,hours of day]=
	LP STOR DISCHARGE(Region Numbers[Region], Timeslice Numbers[timeslice] , Hour Numbers\
		[hours of day] ,2)
